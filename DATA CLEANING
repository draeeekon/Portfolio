-- Check for null values
SELECT
    COUNT(*) AS total_rows,
    COUNT("YEAR") AS non_null_years,
    COUNT(*) - COUNT("YEAR") AS null_years
FROM movies;

-- CHECK null values
SELECT *
FROM movies
WHERE "YEAR" IS NULL
LIMIT 50;


SELECT
    "MOVIES",
    "YEAR",
    "RATING",
    "VOTES",
    "RunTime"
FROM movies
WHERE "YEAR" IS NULL
LIMIT 50;

-- Check if the missing years are missing runtime 
SELECT
    COUNT(*) AS missing_year,
    COUNT(*) FILTER (WHERE "RATING" IS NULL) AS also_missing_rating,
    COUNT(*) FILTER (WHERE "VOTES" IS NULL) AS also_missing_votes,
    COUNT(*) FILTER (WHERE "RunTime" IS NULL) AS also_missing_runtime
FROM movies
WHERE "YEAR" IS NULL;

-- Check missing runtime
SELECT 
    "MOVIES",
    "YEAR",
    "RATING",
    "VOTES",
    "RunTime"
FROM movies
WHERE "YEAR" IS NULL
  AND "RunTime" IS NOT NULL;

-- Some records have a known runtime but no release year, rating, or votes. These appear to be incomplete or possibly unreleased/upcoming titles, so the missing year was retained as NULL rather than imputed.

-- Check for duplicates
SELECT
    "MOVIES",
    "YEAR",
    "GENRE",
    "RATING",
    "ONE-LINE",
    "STARS",
    "VOTES",
    "RunTime",
    "Gross",
    COUNT(*) AS occurrences
FROM movies
GROUP BY
    "MOVIES",
    "YEAR",
    "GENRE",
    "RATING",
    "ONE-LINE",
    "STARS",
    "VOTES",
    "RunTime",
    "Gross"
HAVING COUNT(*) > 1;

-- Create clean table and removing duplicates
CREATE TABLE movies_clean AS
SELECT DISTINCT *
FROM movies;
-- count rows in each table
SELECT COUNT(*) AS raw_rows
FROM movies;

SELECT COUNT(*) AS cleaned_rows
FROM movies_clean;
-- count how many rows removed
SELECT
    (SELECT COUNT(*) FROM movies) -
    (SELECT COUNT(*) FROM movies_clean)
    AS duplicate_rows_removed;

-- Check for text misalignment
SELECT "GENRE"
FROM movies
WHERE "GENRE" <> TRIM("GENRE");

SELECT DISTINCT "GENRE"
FROM movies
ORDER BY "GENRE";


-- Check Year
SELECT DISTINCT "YEAR"
FROM movies
ORDER BY "YEAR";
-- check impossible ratings
SELECT *
FROM movies
WHERE "RATING"::NUMERIC < 0
   OR "RATING"::NUMERIC > 10;
-- numeric field was stored as text . no impossible values found

SELECT DISTINCT "RATING"
FROM movies
WHERE "RATING" IS NOT NULL
ORDER BY "RATING";
