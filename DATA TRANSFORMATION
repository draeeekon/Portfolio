-- Changing datatype for rating and runtime
alter table movies_clean
alter column "RATING" TYPE NUMERIC using "RATING"::NUMERIC;

alter table movies_clean
alter column "RunTime" TYPE INTEGER using "RunTime"::INTEGER;

alter table movies_clean
alter column "VOTES" TYPE INTEGER using REPLACE("VOTES", ',', '')::INTEGER;

select
  "Gross"
from
  movies_clean

SELECT
    "Gross",
    REPLACE(
        REPLACE(TRIM("Gross"), '$', ''),
        'M', ''
    )::NUMERIC * 1000000 AS converted_gross
FROM movies_clean
WHERE "Gross" IS NOT NULL
LIMIT 20;
-- Update movies_clean table converting into numeric
UPDATE movies_clean
SET gross_usd =
    REPLACE(
        REPLACE(TRIM("Gross"), '$', ''),
        'M', ''
    )::NUMERIC * 1000000
WHERE "Gross" IS NOT NULL;
--check if it works
SELECT
    COUNT(*) AS total_rows,
    COUNT("Gross") AS original_gross_values,
    COUNT(gross_usd) AS converted_gross_values
FROM movies_clean;

--clean and split year 
ALTER TABLE movies_clean
ADD COLUMN start_year INTEGER,
ADD COLUMN end_year INTEGER;

-- update single year values first
UPDATE movies_clean
SET start_year =
    REPLACE(REPLACE("YEAR", '(', ''), ')', '')::INTEGER
WHERE "YEAR" ~ '^\([0-9]{4}\)$';

-- standardize text fields
UPDATE movies_clean
SET "GENRE" = TRIM("GENRE"),
    "MOVIES" = TRIM("MOVIES");

UPDATE movies_clean
SET "GENRE" = TRIM(REPLACE("GENRE", E'\n', ' '));

--validation
SELECT
    MIN("RATING"),
    MAX("RATING"),
    MIN("RunTime"),
    MAX("RunTime"),
    MIN("VOTES"),
    MAX("VOTES")
FROM movies_clean;

SELECT *
FROM movies_clean
LIMIT 20;

SELECT
    "YEAR",
    SUBSTRING("YEAR" FROM '[0-9]{4}') AS extracted_start_year
FROM movies_clean
WHERE "YEAR" IS NOT NULL
LIMIT 30;
--update start_year
UPDATE movies_clean
SET start_year =
    SUBSTRING("YEAR" FROM '[0-9]{4}')::INTEGER
WHERE "YEAR" IS NOT NULL;
-- Update end_year with case when statements to differentiate ranges
UPDATE movies_clean
SET end_year =
    CASE
        -- Single year: (2020)
        WHEN "YEAR" ~ '^\([0-9]{4}\)$'
            THEN SUBSTRING("YEAR" FROM '[0-9]{4}')::INTEGER

        -- Closed range: (2016–2021)
        WHEN "YEAR" ~ '[0-9]{4}.*[0-9]{4}'
            THEN SUBSTRING("YEAR" FROM '[0-9]{4}[^0-9]+([0-9]{4})')::INTEGER

        -- Ongoing series: (2021– )
        ELSE NULL
    END
WHERE "YEAR" IS NOT NULL;
--Validation
SELECT
    "YEAR",
    start_year,
    end_year
FROM movies_clean
WHERE "YEAR" IS NOT NULL
LIMIT 50;

-- Final validation
SELECT
    COUNT(*) AS total_rows,
    COUNT(DISTINCT "MOVIES") AS unique_movies,
    COUNT(start_year) AS rows_with_start_year,
    COUNT(end_year) AS rows_with_end_year,
    COUNT("RATING") AS rows_with_rating,
    COUNT("VOTES") AS rows_with_votes,
    COUNT(gross_usd) AS rows_with_gross
FROM movies_clean;

